PORT=5000
MONGO_URI=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# ADMIN_EMAIL is used to seed the first admin account (npm run seed:admin)
# and, from Tier D onward, as the recipient for internal notification/
# digest emails. ADMIN_PASSWORD is only needed for seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend, used via its SMTP relay (see Backend/utils/mailer.js). EMAIL_FROM
# defaults to Resend's shared sandbox address, which works with no domain
# verification — swap it for a verified domain address before going live.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
